# Copy to .env and fill in. .env is git-ignored — never commit real values.
# 通知は Discord / Telegram の設定済みチャンネルすべてに送られる。片方だけでもよい。

# --- Discord (通知) ---
# サーバー設定 → 連携サービス → ウェブフック で作成したURLを貼る。
# 例: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# --- Telegram (通知/承認) ---
# BotFather で発行した bot token（使わないなら空でよい）
TELEGRAM_BOT_TOKEN=
# 通知先の chat id（自分との1:1チャットなら自分のuser id）
TELEGRAM_CHAT_ID=

# --- Zenn ---
# 公開URL組み立て用。https://zenn.dev/<ZENN_USERNAME>/articles/<slug>
ZENN_USERNAME=nkchan

# --- 変換エンジン (claude -p) ---
# claude バイナリのパス。PATHが通っていれば "claude" のままでよい。
# 例(mac / native installer): /Users/kaoru/.local/bin/claude
CLAUDE_BIN=claude
# 1回の変換のタイムアウト秒（spec: 10分）
CLAUDE_TIMEOUT=600
# 暴走防止のターン数上限
CLAUDE_MAX_TURNS=1

# --- protocol-lab の取得元 ---
# 通常はデフォルトのままでよい。ローカルテスト時にローカルパスへ差し替え可。
PROTOCOL_LAB_REPO=git@github.com:pathvector-studio/protocol-lab.git
PROTOCOL_LAB_BRANCH=main
