# Copy to .env and fill in. .env is git-ignored — never commit real values.
# 通知は Discord / Telegram の設定済みチャンネルすべてに送られる。片方だけでもよい。

# --- Discord (通知) ---
# サーバー設定 → 連携サービス → ウェブフック で作成したURLを貼る。
# 例: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# --- Telegram (通知/承認) ---
# BotFather で発行した bot token（使わないなら空でよい）
TELEGRAM_BOT_TOKEN=
# 通知先の chat id（自分との1:1チャットなら自分のuser id）
TELEGRAM_CHAT_ID=

# --- Zenn ---
# 公開URL組み立て + 公開状況の突合API に使う実ユーザ名。
#   https://zenn.dev/<ZENN_USERNAME>/articles/<slug>
#   https://zenn.dev/api/articles?username=<ZENN_USERNAME>
# 重要: GitHubアカウント名(nkchan)ではなく Zenn の実表示ユーザ名 you2h を使う。
#   nkchan はリダイレクトされ、API は username=nkchan だと 0 件を返すため、
#   status.sh / verify_live が「全記事が未公開」と誤判定する。
ZENN_USERNAME=you2h

# --- 変換ソース ---
# 変換対象のソース（空白区切り）。protocol-in-code は有償化予定のためZenn非公開。
# 既定は protocol-lab のみ。in-code を戻しても publish.sh がデプロイをハード拒否する。
SOURCES=protocol-lab

# --- 変換エンジン (claude -p) ---
# claude バイナリのパス。PATHが通っていれば "claude" のままでよい。
# 例(mac / native installer): /Users/kaoru/.local/bin/claude
CLAUDE_BIN=claude
# 1回の変換のタイムアウト秒（spec: 10分）
CLAUDE_TIMEOUT=600
# 暴走防止のターン数上限
CLAUDE_MAX_TURNS=1

# --- protocol-lab の取得元 ---
# 通常はデフォルトのままでよい。ローカルテスト時にローカルパスへ差し替え可。
PROTOCOL_LAB_REPO=git@github.com:pathvector-studio/protocol-lab.git
PROTOCOL_LAB_BRANCH=main
